[Unit]
Description=Ceph 17.2.7 mon.%i
Wants=network-online.target
After=network-online.target
Conflicts=ceph-mon@%i.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/home/cyf/ceph-dpu/build/lib
Environment=PYTHONPATH=/home/cyf/ceph-dpu/build/lib/cython_modules/lib.3:/home/cyf/ceph-dpu/src/pybind:/home/cyf/ceph-dpu/src/python-common
LimitNOFILE=1048576
LimitMEMLOCK=infinity
TasksMax=infinity
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
User=cyf
Group=cyf
ExecStart=/home/cyf/ceph-dpu/build/bin/ceph-mon -f --conf /etc/ceph/ceph.conf --cluster ceph --id %i --mon-data /var/lib/ceph/mon/ceph-%i --admin-socket /run/ceph/ceph-mon.%i.asok --pid-file /run/ceph/ceph-mon.%i.pid --log-file /var/log/ceph/quincy-mon.%i.log

[Install]
WantedBy=multi-user.target
