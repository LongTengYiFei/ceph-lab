   l_rocksdb_write_pre_and_post_process_time,
+  l_rocksdb_submitted_txns,
+  l_rocksdb_submitted_ops,
+  l_rocksdb_submitted_bytes,
   l_rocksdb_last,
 };
 
diff --git a/src/test/objectstore/test_kv.cc b/src/test/objectstore/test_kv.cc
index abc43f46d9..91eed6c368 100644
--- a/src/test/objectstore/test_kv.cc
+++ b/src/test/objectstore/test_kv.cc
@@ -24,6 +24,7 @@
 #include "global/global_init.h"
 #include "common/Cond.h"
 #include "common/errno.h"
+#include "common/perf_counters.h"
 #include "include/stringify.h"
 #include <gtest/gtest.h>
 
@@ -261,6 +262,113 @@ TEST_P(KVTest, Merge) {
   fini();
 }
 
+TEST_P(KVTest, SubmittedCounters) {
+  if (string(GetParam()) != "rocksdb") {
+    GTEST_SKIP() << "RocksDB-specific counters";
+  }
+  ASSERT_EQ(0, db->set_merge_operator("A", make_shared<AppendMOP>()));
+  ASSERT_EQ(0, db->create_and_open(cout));
+  auto* logger = db->get_perf_counters();
+  ASSERT_NE(nullptr, logger);
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_txns));
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_ops));
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_bytes));
+
+  bufferlist value;
+  value.append(string(4096, 'v'));
+  auto async = db->get_transaction();
+  async->set("P", "key", value);
+  async->set("P", "key", value); // Count repeated updates, not unique keys.
+  async->rmkey("P", "missing");
+  const auto async_bytes =
+    static_cast<RocksDBStore::RocksDBTransactionImpl*>(async.get())
+      ->bat.GetDataSize();
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_bytes));
+  ASSERT_EQ(0, db->submit_transaction(async));
+  ASSERT_EQ(1u, logger->get(l_rocksdb_submitted_txns));
+  ASSERT_EQ(3u, logger->get(l_rocksdb_submitted_ops));
+  ASSERT_EQ(async_bytes, logger->get(l_rocksdb_submitted_bytes));
+
+  auto sync = db->get_transaction();
+  sync->rmkey("P", "key");
+  sync->merge("A", "merged", value);
+  const auto sync_bytes =
+    static_cast<RocksDBStore::RocksDBTransactionImpl*>(sync.get())
+      ->bat.GetDataSize();
+  ASSERT_EQ(0, db->submit_transaction_sync(sync));
+  ASSERT_EQ(2u, logger->get(l_rocksdb_submitted_txns));
+  ASSERT_EQ(5u, logger->get(l_rocksdb_submitted_ops));
+  ASSERT_EQ(async_bytes + sync_bytes,
+            logger->get(l_rocksdb_submitted_bytes));
+
+  bufferlist result;
+  ASSERT_EQ(0, db->get("A", "merged", &result));
+  ASSERT_EQ("?" + string(4096, 'v'), _bl_to_str(result));
+  db->compact(); // RocksDB's internal rewrites must not count as submissions.
+  ASSERT_EQ(2u, logger->get(l_rocksdb_submitted_txns));
+  ASSERT_EQ(5u, logger->get(l_rocksdb_submitted_ops));
+  ASSERT_EQ(async_bytes + sync_bytes,
+            logger->get(l_rocksdb_submitted_bytes));
+}
+
+TEST_P(KVTest, SubmittedCountersEmptyAndReset) {
+  if (string(GetParam()) != "rocksdb") {
+    GTEST_SKIP() << "RocksDB-specific counters";
+  }
+  ASSERT_EQ(0, db->create_and_open(cout));
+  auto* logger = db->get_perf_counters();
+  ASSERT_NE(nullptr, logger);
+
+  auto empty = db->get_transaction();
+  const auto empty_bytes =
+    static_cast<RocksDBStore::RocksDBTransactionImpl*>(empty.get())
+      ->bat.GetDataSize();
+  ASSERT_GT(empty_bytes, 0u); // The serialized batch header is included.
+  ASSERT_EQ(0, db->submit_transaction_sync(empty));
+  ASSERT_EQ(1u, logger->get(l_rocksdb_submitted_txns));
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_ops));
+  ASSERT_EQ(empty_bytes, logger->get(l_rocksdb_submitted_bytes));
+
+  // Use the same collection reset as the admin-socket "perf reset rocksdb".
+  ASSERT_TRUE(g_ceph_context->get_perfcounters_collection()->reset("rocksdb"));
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_txns));
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_ops));
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_bytes));
+
+  bufferlist value;
+  value.append("after-reset");
+  auto t = db->get_transaction();
+  t->set("P", "key", value);
+  const auto bytes =
+    static_cast<RocksDBStore::RocksDBTransactionImpl*>(t.get())
+      ->bat.GetDataSize();
+  ASSERT_EQ(0, db->submit_transaction(t));
+  ASSERT_EQ(1u, logger->get(l_rocksdb_submitted_txns));
+  ASSERT_EQ(1u, logger->get(l_rocksdb_submitted_ops));
+  ASSERT_EQ(bytes, logger->get(l_rocksdb_submitted_bytes));
+}
+
+TEST_P(KVTest, SubmittedCountersFailedWrite) {
+  if (string(GetParam()) != "rocksdb") {
+    GTEST_SKIP() << "RocksDB-specific counters";
+  }
+  ASSERT_EQ(0, db->create_and_open(cout));
+  db->close();
+  ASSERT_EQ(0, db->open_read_only(cout));
+  auto* logger = db->get_perf_counters();
+  ASSERT_NE(nullptr, logger);
+
+  bufferlist value;
+  value.append("read-only");
+  auto t = db->get_transaction();
+  t->set("P", "key", value);
+  ASSERT_NE(0, db->submit_transaction(t));
+  ASSERT_NE(0, db->submit_transaction_sync(t));
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_txns));
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_ops));
+  ASSERT_EQ(0u, logger->get(l_rocksdb_submitted_bytes));
+}
+
 TEST_P(KVTest, RMRange) {
   ASSERT_EQ(0, db->create_and_open(cout));
   bufferlist value;
