index 01c84f2d0b..a08c8a16c1 100644
--- a/src/kv/RocksDBStore.h
+++ b/src/kv/RocksDBStore.h
@@ -42,6 +42,9 @@ enum {
   l_rocksdb_write_memtable_time,
